{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "css:watch": "node watch-css.cjs",
        "css:sync": "node -e \"const fs=require('fs'),path=require('path');function sync(d,b){fs.readdirSync(d,{withFileTypes:true}).forEach(e=>{const f=path.join(d,e.name);if(e.isDirectory())sync(f,b);else if(e.name.endsWith('.css')){const rel=path.relative(b,f),dest=path.join('public','css',rel);fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(f,dest);console.log('synced:',rel);}});}sync('resources/css','resources/css');\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8"
    }
}
